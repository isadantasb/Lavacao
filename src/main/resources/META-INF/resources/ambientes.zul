<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        <div sclass="sidebar">
            <div sclass="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0">
                    <label value="HUM" sclass="logo-title"/>
                    <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                </vlayout>
            </div>
            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn" href="historico.zul"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn active"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn" href="usuarios.zul"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn" href="configuracoes.zul"/>
            </vlayout>
            <div sclass="user-profile">
                <div sclass="avatar">A</div>
                <vlayout spacing="0">
                    <label value="Ana Souza" sclass="user-name"/>
                    <label value="Administrador" sclass="user-role"/>
                </vlayout>
                <button label="Sair" sclass="logout-btn" href="teste.zul"/>
            </div>
        </div>

        <div sclass="main-content">
            <hlayout sclass="page-toolbar right-edge-toolbar" valign="top">
                <vlayout spacing="5px">
                    <label value="Ambientes" sclass="page-heading"/>
                    <label value="Salas e setores cadastrados" sclass="page-subheading"/>
                </vlayout>
                <textbox placeholder="Buscar..." sclass="environment-search"/>
            </hlayout>
            <hlayout sclass="environment-actions" width="100%">
                <button id="btnNovoAmbiente" label="+ Novo ambiente" sclass="btn-primary new-environment-button" onClick="self.getPage().getFellow(&quot;modalNovoAmbiente&quot;).setVisible(true)"/>
            </hlayout>
            <div sclass="empty-environments">
                <label value="Nenhum ambiente cadastrado" sclass="empty-environments-title"/>
                <label value="Clique em + Novo ambiente para adicionar a primeira sala." sclass="empty-environments-text"/>
            </div>
        </div>
    </div>

    <window id="modalNovoAmbiente" title="Novo ambiente" mode="modal" visible="false" closable="true" onClose="event.stopPropagation(); self.setVisible(false)" width="500px" sclass="custom-modal">
        <vlayout spacing="20px" style="padding: 24px;">
            <vlayout spacing="5px">
                <label value="Número da sala" sclass="input-label"/>
                <textbox sclass="custom-input"/>
            </vlayout>
            <vlayout spacing="5px">
                <label value="Setor" sclass="input-label"/>
                <textbox sclass="custom-input"/>
            </vlayout>
            <vlayout spacing="5px">
                <label value="Partes da sala" sclass="input-label"/>
                <hlayout spacing="10px" width="100%">
                    <button label="Box" sclass="btn-toggle" hflex="1"/>
                    <button label="Banheiro" sclass="btn-toggle" hflex="1"/>
                    <button label="Lavabo" sclass="btn-toggle" hflex="1"/>
                </hlayout>
            </vlayout>
            <hlayout spacing="15px" style="margin-top: 10px; text-align: right;" width="100%">
                <button label="Cancelar" sclass="btn-cancel" onClick="self.getPage().getFellow(&quot;modalNovoAmbiente&quot;).setVisible(false)"/>
                <button label="Salvar" sclass="btn-primary" style="width: auto; padding: 10px 24px;"/>
            </hlayout>
        </vlayout>
    </window>
</zk>
