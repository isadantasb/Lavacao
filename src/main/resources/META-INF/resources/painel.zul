<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout" apply="com.example.demo.PainelComposer">
        <div sclass="sidebar">
            <div sclass="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0">
                    <label value="HUM" sclass="logo-title"/>
                    <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                </vlayout>
            </div>
            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn active"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" onClick="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).setVisible(true)"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn" href="historico.zul"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn" href="ambientes.zul"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn" href="usuarios.zul"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn" href="configuracoes.zul"/>
            </vlayout>
            <div sclass="user-profile">
                <div sclass="avatar">A</div>
                <vlayout spacing="0">
                    <label value="Ana Souza" sclass="user-name"/>
                    <label value="Administrador" sclass="user-role"/>
                </vlayout>
                <button label="Sair" sclass="logout-btn" href="teste.zul"/>
            </div>
        </div>
        <div sclass="main-content">
            <vlayout spacing="5px" style="margin-bottom: 24px;">
                <label value="Painel de Limpezas" sclass="page-heading"/>
                <label value="Visão geral dos ambientes e prazos" sclass="page-subheading"/>
            </vlayout>
            <hlayout spacing="20px" sclass="summary-cards-container">
                <div sclass="summary-card card-black">
                    <image src="~./images/skull.png" sclass="summary-icon"/>
                    <label id="expiradosCount" value="0" sclass="summary-number"/>
                    <label value="Expirados" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-red">
                    <image src="~./images/urgente-icon.png" sclass="summary-icon"/>
                    <label id="urgenteCount" value="0" sclass="summary-number"/>
                    <label value="Urgente / atrasado" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-yellow">
                    <image src="~./images/relogio.png" sclass="summary-icon"/>
                    <label id="atencaoCount" value="0" sclass="summary-number"/>
                    <label value="Atenção" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-green">
                    <image src="~./images/check.png" sclass="summary-icon"/>
                    <label id="emDiaCount" value="0" sclass="summary-number"/>
                    <label value="Em dia" sclass="summary-text"/>
                </div>
            </hlayout>
            <div sclass="filter-bar">
                <textbox placeholder="Pesquisar por sala" sclass="search-input"/>
                <hlayout spacing="15px" valign="middle">
                    <combobox placeholder="Todos os setores" sclass="sector-combo">
                        <comboitem label="Maternidade"/>
                        <comboitem label="Pediatria"/>
                        <comboitem label="UTI"/>
                    </combobox>
                    <button id="btnRegistrarLimpeza" label="+ Registrar Limpeza" sclass="btn-primary btn-add" onClick="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).setVisible(true)"/>
                </hlayout>
            </div>
            <div id="containerDeSalas" sclass="rooms-grid"/>
        </div>
    </div>
    <window id="modalNovoAmbiente" title="Novo ambiente" mode="modal" visible="false" closable="true" onClose="event.stopPropagation(); self.setVisible(false)" width="500px" sclass="custom-modal">
        <vlayout spacing="20px" style="padding: 24px;">
            <vlayout spacing="5px">
                <label value="Número da sala" sclass="input-label"/>
                <textbox id="salaInput" sclass="custom-input"/>
            </vlayout>
            
            <vlayout spacing="5px">
                <label value="Setor" sclass="input-label"/>
                <textbox id="setorInput" sclass="custom-input"/>
            </vlayout>
            
            <vlayout spacing="5px">
                <label value="Partes da sala" sclass="input-label"/>
                <hlayout spacing="10px">
                    <button id="parteBox" label="Box" sclass="btn-toggle"/>
                    <button id="parteBanheiro" label="Banheiro" sclass="btn-toggle"/>
                    <button id="parteLavabo" label="Lavabo" sclass="btn-toggle"/>
                </hlayout>
            </vlayout>
            
            <hlayout spacing="15px" style="margin-top: 10px; text-align: right;" width="100%">
                <button label="Cancelar" sclass="btn-cancel" onClick="self.getPage().getFellow(&quot;modalNovoAmbiente&quot;).setVisible(false)"/>
                <button id="salvarAmbiente" label="Salvar" sclass="btn-primary" style="width: auto; padding: 10px 24px;"/>
            </hlayout>
        </vlayout>
    </window>

    <!-- Painel de registrar limpeza -->
    <window id="modalNovaLimpeza" title="Nova limpeza&#10;Registrar Limpeza" mode="modal" visible="false" closable="true" onClose="event.stopPropagation(); self.setVisible(false)" width="700px" sclass="custom-modal">
        <vlayout sclass="modal-form" spacing="15px">
            
            <hlayout sclass="modal-row" spacing="15px">
                <vlayout sclass="modal-field" spacing="5px" hflex="1">
                    <label value="Data" sclass="input-label"/>
                    <datebox id="dataLimpeza" format="dd/MM/yyyy" sclass="custom-input" hflex="1" style="height: 40px;"/>
                </vlayout>
                <vlayout sclass="modal-field" spacing="5px" hflex="1">
                    <label value="Hora" sclass="input-label"/>
                    <timebox sclass="custom-input" hflex="1" style="height: 40px;"/>
                </vlayout>
            </hlayout>
            
            <vlayout sclass="modal-field" spacing="5px">
                <label value="Ambiente" sclass="input-label"/>
                <combobox id="ambienteLimpeza" placeholder="Selecione um ambiente" sclass="custom-input" hflex="1" style="height: 40px;"/>
            </vlayout>
            
            <vlayout sclass="modal-field" spacing="5px">
                <label value="Tipo de limpeza" sclass="input-label"/>
                <hlayout sclass="modal-options" spacing="10px">
                    <button label="Terminal Simples" sclass="btn-toggle" hflex="1"/>
                    <button label="Terminal Dupla" sclass="btn-toggle" hflex="1"/>
                    <button label="Embelezamento" sclass="btn-toggle" hflex="1"/>
                </hlayout>
            </vlayout>

            <vlayout sclass="modal-field" spacing="5px">
                <label value="Encarregado" sclass="input-label"/>
                <textbox placeholder="Ex.: Maria" sclass="custom-input"/>
            </vlayout>
            
            <vlayout sclass="modal-field" spacing="5px">
                <label value="Equipe" sclass="input-label"/>
                <textbox placeholder="Ex.: José, Ana, Roberta" sclass="custom-input"/>
            </vlayout>
            
            <vlayout sclass="modal-field" spacing="5px">
                <label value="Observações" sclass="input-label"/>
                <textbox placeholder="Ex.: Limpeza após alta do paciente" sclass="custom-input"/>
            </vlayout>

            <vlayout sclass="atp-section" spacing="15px">
                <checkbox label="Realizou teste ATP?" style="font-weight: 500;" onCheck="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).getFellow(&quot;atpResults&quot;).setVisible(self.isChecked())"/>
                <hlayout id="atpResults" sclass="atp-results" spacing="12px" visible="false">
                    <vlayout spacing="5px" hflex="1">
                        <label value="Resultado do Teste Atual" sclass="input-label"/>
                        <textbox placeholder="Ex.: 120 RLU" sclass="custom-input"/>
                    </vlayout>
                    <vlayout spacing="5px" hflex="1">
                        <label value="Resultado do Teste Anterior" sclass="input-label"/>
                        <textbox placeholder="Ex.: 150 RLU" sclass="custom-input"/>
                    </vlayout>
                </hlayout>
            </vlayout>
            
            <hlayout sclass="modal-actions" spacing="15px" width="100%">
                <button label="Cancelar" sclass="btn-cancel" onClick="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).setVisible(false)"/>
                <button id="salvarLimpeza" label="Salvar registro" sclass="btn-primary modal-save"/>
            </hlayout>
        </vlayout>
    </window>
</zk>
