<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        <div sclass="sidebar">
            <div sclass="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0">
                    <label value="HUM" sclass="logo-title"/>
                    <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                </vlayout>
            </div>
            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn active" href="historico.zul"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn" href="ambientes.zul"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn" href="usuarios.zul"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn" href="configuracoes.zul"/>
            </vlayout>
            <div sclass="user-profile">
                <div sclass="avatar">A</div>
                <vlayout spacing="0">
                    <label value="Ana Souza" sclass="user-name"/>
                    <label value="Administrador" sclass="user-role"/>
                </vlayout>
                <button label="Sair" sclass="logout-btn" href="teste.zul"/>
            </div>
        </div>
        <div sclass="main-content">
            <hlayout sclass="page-toolbar right-edge-toolbar">
                <vlayout spacing="5px">
                    <label value="Histórico de Limpezas" sclass="page-heading"/>
                    <label value="Todos os registros realizados" sclass="page-subheading"/>
                </vlayout>
                <textbox placeholder="Buscar..." sclass="environment-search"/>
            </hlayout>
            <div sclass="history-toolbar">
                <hlayout sclass="history-filters" spacing="8px">
                    <button label="6 meses" sclass="filter-chip active"/>
                    <button label="3 meses" sclass="filter-chip"/>
                    <button label="30 dias" sclass="filter-chip"/>
                    <button label="1 semana" sclass="filter-chip"/>
                </hlayout>
                <button label="Exportar (ANVISA)" sclass="btn-export"/>
            </div>
            <div sclass="empty-history">
                <div sclass="empty-history-icon">H</div>
                <label value="Nenhuma limpeza registrada" sclass="empty-state-title"/>
                <label value="O histórico será preenchido assim que uma limpeza for registrada." sclass="empty-state-text"/>
                <button label="Registrar primeira limpeza" sclass="btn-primary empty-state-action" href="painel.zul"/>
            </div>
        </div>
    </div>
</zk>
