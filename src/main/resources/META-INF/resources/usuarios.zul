<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        <div sclass="sidebar">
            <div sclass="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0">
                    <label value="HUM" sclass="logo-title"/>
                    <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                </vlayout>
            </div>
            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn" href="historico.zul"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn" href="ambientes.zul"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn active" href="usuarios.zul"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn" href="configuracoes.zul"/>
            </vlayout>
            <div sclass="user-profile">
                <div sclass="avatar">A</div>
                <vlayout spacing="0">
                    <label value="Ana Souza" sclass="user-name"/>
                    <label value="Administrador" sclass="user-role"/>
                </vlayout>
                <button label="Sair" sclass="logout-btn" href="teste.zul"/>
            </div>
        </div>
        <div sclass="main-content">
            <hlayout sclass="page-toolbar users-page-toolbar">
                <vlayout spacing="5px">
                    <label value="Usuários" sclass="page-heading"/>
                    <label value="Gerencie usuários do sistema" sclass="page-subheading"/>
                </vlayout>
                <vlayout sclass="users-actions-stack" spacing="16px">
                    <textbox placeholder="Buscar..." sclass="environment-search"/>
                    <button label="+ Novo Usuário" sclass="btn-primary page-action-button"/>
                </vlayout>
            </hlayout>
            <div sclass="data-table user-table">
                <hlayout sclass="table-row table-header">
                    <label value="NOME" sclass="user-name-column"/>
                    <label value="DOCUMENTO" sclass="user-document-column"/>
                    <label value="E-MAIL" sclass="user-email-column"/>
                    <label value="PERFIL" sclass="user-profile-column"/>
                    <label value="" sclass="user-actions-column"/>
                </hlayout>
                <hlayout sclass="table-row">
                    <hlayout sclass="user-name-column user-cell" spacing="12px" valign="middle"><div sclass="user-initial">A</div><label value="Ana Souza"/></hlayout>
                    <label value="123.456.789-01" sclass="user-document-column user-muted"/>
                    <label value="ana@hum.br" sclass="user-email-column user-muted"/>
                    <label value="Administrador" sclass="role-badge role-admin user-profile-column"/>
                    <hlayout sclass="user-actions-column row-actions" spacing="14px"><button label="Editar" sclass="table-action edit-action"/><button label="Excluir" sclass="table-action delete-action"/></hlayout>
                </hlayout>
                <hlayout sclass="table-row">
                    <hlayout sclass="user-name-column user-cell" spacing="12px" valign="middle"><div sclass="user-initial">C</div><label value="Carlos Lima"/></hlayout>
                    <label value="987.654.321-09" sclass="user-document-column user-muted"/>
                    <label value="carlos@hum.br" sclass="user-email-column user-muted"/>
                    <label value="Usuário" sclass="role-badge role-user user-profile-column"/>
                    <hlayout sclass="user-actions-column row-actions" spacing="14px"><button label="Editar" sclass="table-action edit-action"/><button label="Excluir" sclass="table-action delete-action"/></hlayout>
                </hlayout>
                <hlayout sclass="table-row">
                    <hlayout sclass="user-name-column user-cell" spacing="12px" valign="middle"><div sclass="user-initial">M</div><label value="Mariana Pires"/></hlayout>
                    <label value="111.222.333-44" sclass="user-document-column user-muted"/>
                    <label value="mariana@hum.br" sclass="user-email-column user-muted"/>
                    <label value="Usuário" sclass="role-badge role-user user-profile-column"/>
                    <hlayout sclass="user-actions-column row-actions" spacing="14px"><button label="Editar" sclass="table-action edit-action"/><button label="Excluir" sclass="table-action delete-action"/></hlayout>
                </hlayout>
                <hlayout sclass="table-row">
                    <hlayout sclass="user-name-column user-cell" spacing="12px" valign="middle"><div sclass="user-initial">J</div><label value="João Ribeiro"/></hlayout>
                    <label value="555.666.777-88" sclass="user-document-column user-muted"/>
                    <label value="joao@hum.br" sclass="user-email-column user-muted"/>
                    <label value="Usuário" sclass="role-badge role-user user-profile-column"/>
                    <hlayout sclass="user-actions-column row-actions" spacing="14px"><button label="Editar" sclass="table-action edit-action"/><button label="Excluir" sclass="table-action delete-action"/></hlayout>
                </hlayout>
            </div>
        </div>
    </div>
</zk>
