<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        <div sclass="sidebar">
            <div class="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0"><label value="HUM" sclass="logo-title"/><label value="Gestão de Lavações" sclass="logo-subtitle"/></vlayout>
            </div>
            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" href="painel.zul"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn" href="historico.zul"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn" href="ambientes.zul"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn" href="usuarios.zul"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn active" href="configuracoes.zul"/>
            </vlayout>
            <div sclass="user-profile">
                <div sclass="avatar">A</div><vlayout spacing="0"><label value="Ana Souza" sclass="user-name"/><label value="Administrador" sclass="user-role"/></vlayout>
                <button label="Sair" sclass="logout-btn" href="teste.zul"/>
            </div>
        </div>
        <div sclass="main-content">
            <hlayout sclass="page-toolbar">
                <vlayout spacing="5px"><label value="Configurações" sclass="page-heading"/><label value="Conta e preferências" sclass="page-subheading"/></vlayout>
                <button label="Notificações" sclass="icon-button"/>
            </hlayout>
            <hlayout sclass="settings-layout" spacing="16px">
                <div sclass="settings-card password-card" hflex="7">
                    <label value="Alterar senha" sclass="settings-card-title"/>
                    <vlayout spacing="8px" sclass="settings-form">
                        <label value="Senha atual" sclass="input-label"/><textbox type="password" sclass="settings-input"/>
                        <hlayout spacing="12px" width="100%">
                            <vlayout spacing="8px" hflex="1"><label value="Nova senha" sclass="input-label"/><textbox type="password" sclass="settings-input"/></vlayout>
                            <vlayout spacing="8px" hflex="1"><label value="Confirmar nova senha" sclass="input-label"/><textbox type="password" sclass="settings-input"/></vlayout>
                        </hlayout>
                        <button label="Salvar nova senha" sclass="btn-primary settings-save"/>
                    </vlayout>
                </div>
                <div sclass="settings-card profile-card" hflex="3">
                    <div sclass="profile-avatar-large">A</div>
                    <label value="Ana Souza" sclass="profile-name"/>
                    <label value="ana@hum.br" sclass="profile-email"/>
                    <label value="Administrador" sclass="role-badge role-admin"/>
                </div>
            </hlayout>
        </div>
    </div>
</zk>
