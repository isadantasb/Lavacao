<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="login-page">
        <div sclass="login-card">
            
            <!-- Lado esquerdo: retângulo verde -->
            <div sclass="login-left">
                <div sclass="logo-container">
                    <image src="~./images/logo_lavacao.png" sclass="logo-img"/>
                    <vlayout spacing="0">
                        <label value="HUM" sclass="logo-title"/>
                        <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                    </vlayout>
                </div>
                
                <vlayout spacing="15px" sclass="welcome-text">
                    <label value="Hospital Universitário Regional de Maringá" sclass="main-title"/>
                    <label value="Sistema digital para registro e controle de limpezas em conformidade com a ANVISA." sclass="main-description"/>
                </vlayout>
                
                <label value="© 2026 HUM - DIN — UEM" sclass="footer-text"/>
            </div>
            
            <!-- Lado direito: preencher infos -->
            <div sclass="login-right">
                <vlayout spacing="2px" style="margin-bottom: 25px;">
                    <label value="Entrar no sistema" sclass="form-title"/>
                    <label value="Acesse com seu e-mail e senha." sclass="form-subtitle"/>
                </vlayout>
                
                <vlayout spacing="15px" sclass="form-layout">
                    <vlayout spacing="5px">
                        <label value="E-mail" sclass="input-label"/>
                        <textbox placeholder="ana@hum.br" sclass="custom-input"/>
                    </vlayout>
                    
                    <vlayout spacing="5px">
                        <label value="Senha" sclass="input-label"/>
                        <textbox type="password" placeholder="••••••••" sclass="custom-input"/>
                    </vlayout>
                    
                    <div style="text-align: right; width: 100%;">
                        <a label="Esqueci minha senha" sclass="forgot-password" href="recuperar-senha.zul"/>
                    </div>
                    
                    <vlayout spacing="10px" style="margin-top: 10px;">
                        <button label="Entrar como Administrador" sclass="btn-primary" href="painel.zul"/>
                        <button label="Entrar como usuário" sclass="btn-secondary" href="painel-usuario.zul"/>
                    </vlayout>
                </vlayout>
            </div>
            
        </div>
    </div>
</zk>
