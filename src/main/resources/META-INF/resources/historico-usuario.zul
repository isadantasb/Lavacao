<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        <div sclass="sidebar">
            <div sclass="sidebar-header"><image src="~./images/logo_lavacao.png" sclass="logo-img-small"/><vlayout spacing="0"><label value="HUM" sclass="logo-title"/><label value="Gestão de Lavações" sclass="logo-subtitle"/></vlayout></div>
            <vlayout sclass="menu-items" spacing="5px"><button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn" href="painel-usuario.zul"/><button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" href="painel-usuario.zul"/><button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn active" href="historico-usuario.zul"/><button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn" href="configuracoes-usuario.zul"/></vlayout>
            <div sclass="user-profile"><div class="avatar">C</div><vlayout spacing="0"><label value="Carlos Lima" sclass="user-name"/><label value="Usuário" sclass="user-role"/></vlayout><button label="Sair" sclass="logout-btn" href="teste.zul"/></div>
        </div>
        <div sclass="main-content">
            <hlayout sclass="page-toolbar"><vlayout spacing="5px"><label value="Meu Histórico de Limpezas" sclass="page-heading"/><label value="Registros realizados por você" sclass="page-subheading"/></vlayout><textbox placeholder="Buscar..." sclass="environment-search"/></hlayout>
            <div sclass="history-toolbar"><hlayout sclass="history-filters" spacing="8px"><button label="6 meses" sclass="filter-chip active"/><button label="3 meses" sclass="filter-chip"/><button label="30 dias" sclass="filter-chip"/><button label="1 semana" sclass="filter-chip"/></hlayout><button label="Exportar" sclass="btn-export"/></div>
            <div sclass="empty-history"><div sclass="empty-history-icon">H</div><label value="Nenhuma limpeza registrada" sclass="empty-state-title"/><label value="Seus registros aparecerão aqui após a primeira limpeza." sclass="empty-state-text"/><button label="Registrar primeira limpeza" sclass="btn-primary empty-state-action" href="painel-usuario.zul"/></div>
        </div>
    </div>
</zk>
