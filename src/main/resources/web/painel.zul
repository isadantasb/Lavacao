<?link rel="stylesheet" type="text/css" href="~./css/style.css"?>
<zk>
    <div sclass="dashboard-layout">
        
        <div sclass="sidebar">
            <div sclass="sidebar-header">
                <image src="~./images/logo_lavacao.png" sclass="logo-img-small"/>
                <vlayout spacing="0">
                    <label value="HUM" sclass="logo-title"/>
                    <label value="Gestão de Lavações" sclass="logo-subtitle"/>
                </vlayout>
            </div>

            <vlayout sclass="menu-items" spacing="5px">
                <button label="Painel" image="~./images/painel-icon.png" sclass="menu-btn active"/>
                <button label="Registrar Limpeza" image="~./images/registrarLimpeza-icon.png" sclass="menu-btn" onClick="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).setVisible(true)"/>
                <button label="Histórico" image="~./images/historico-icon.png" sclass="menu-btn"/>
                <button label="Ambientes" image="~./images/ambiente-icon.png" sclass="menu-btn" href="ambientes.zul"/>
                <button label="Usuários" image="~./images/users-icon.png" sclass="menu-btn"/>
                <button label="Configurações" image="~./images/config-icon.png" sclass="menu-btn"/>
            </vlayout>

            <div sclass="user-profile">
                <div sclass="avatar">A</div>
                <vlayout spacing="0">
                    <label value="Ana Souza" sclass="user-name"/>
                    <label value="Administrador" sclass="user-role"/>
                </vlayout>
                <button label="Sair" sclass="logout-btn"/>
            </div>
        </div>

        <div sclass="main-content">
            
            <vlayout spacing="5px" style="margin-bottom: 24px;">
                <label value="Painel de Limpezas" sclass="page-heading"/>
                <label value="Visão geral dos ambientes e prazos" sclass="page-subheading"/>
            </vlayout>

            <hlayout spacing="20px" sclass="summary-cards-container">
                <div sclass="summary-card card-black">
                    <image src="~./images/skull.png" sclass="summary-icon"/>
                    <label value="0" sclass="summary-number"/>
                    <label value="Expirados" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-red">
                    <image src="~./images/urgente-icon.png" sclass="summary-icon"/>
                    <label value="0" sclass="summary-number"/>
                    <label value="Urgente / atrasado" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-yellow">
                    <image src="~./images/relogio.png" sclass="summary-icon"/>
                    <label value="0" sclass="summary-number"/>
                    <label value="Atenção" sclass="summary-text"/>
                </div>
                <div sclass="summary-card card-green">
                    <image src="~./images/check.png" sclass="summary-icon"/>
                    <label value="0" sclass="summary-number"/>
                    <label value="Em dia" sclass="summary-text"/>
                </div>
            </hlayout>

            <div sclass="filter-bar">
                <textbox placeholder="Pesquisar por sala" sclass="search-input"/>
                <hlayout spacing="15px" valign="middle">
                    <combobox placeholder="Todos os setores" sclass="sector-combo">
                        <comboitem label="Maternidade"/>
                        <comboitem label="Pediatria"/>
                        <comboitem label="UTI"/>
                    </combobox>
                    <button label="+ Registrar Limpeza" sclass="btn-primary btn-add" onClick="self.getPage().getFellow(&quot;modalNovaLimpeza&quot;).setVisible(true)"/>
                </hlayout>
            </div>

            <div id="containerDeSalas" sclass="rooms-grid">

            </div>

        </div>
    </div>
</zk>